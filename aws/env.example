AWS_REGION=us-east-1
AWS_PROFILE=default

APP_NAME=Sayable
APP_BRAND="Sayable"
APP_LONG_NAME="Sayable — say the hard thing so it can actually be heard"

# Apex domain. The Route 53 hosted zone for ROOT_DOMAIN must already exist.
ROOT_DOMAIN=sayable.org
APP_DOMAIN=sayable.org

# SES senders must be verified in AWS_REGION before sign-in works:
# aws ses verify-email-identity --email-address <addr> --region us-east-1
OTP_SENDER_EMAIL=no-reply@sayable.org
OTP_SENDER_NAME="Sayable"
NOTIFICATION_SENDER_EMAIL=no-reply@sayable.org

OWNER_EMAIL=muthu.vellayan@gmail.com

JWT_SECRET_NAME=sayable/jwt-secret
ANTHROPIC_SECRET_NAME=sayable/anthropic-api-key
JWT_TTL_DAYS=30
OTP_TTL_MINUTES=10

STACK_NAME=SayableStack
TABLE_PREFIX=Sayable
FRONTEND_BUCKET_PREFIX=sayable-frontend
