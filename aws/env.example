AWS_REGION=us-east-1
AWS_PROFILE=default

APP_NAME=BetterVibe
APP_BRAND="BetterVibe"
APP_LONG_NAME="BetterVibe — say the hard thing so it can actually be heard"

# Apex domain. The Route 53 hosted zone for ROOT_DOMAIN must already exist.
ROOT_DOMAIN=bettervibe.live
APP_DOMAIN=bettervibe.live

# SES senders must be verified in AWS_REGION before sign-in works:
# aws ses verify-email-identity --email-address <addr> --region us-east-1
OTP_SENDER_EMAIL=no-reply@bettervibe.live
OTP_SENDER_NAME="BetterVibe"
NOTIFICATION_SENDER_EMAIL=no-reply@bettervibe.live

OWNER_EMAIL=muthu.vellayan@gmail.com

JWT_SECRET_NAME=bettervibe/jwt-secret
ANTHROPIC_SECRET_NAME=bettervibe/anthropic-api-key
JWT_TTL_DAYS=30
OTP_TTL_MINUTES=10

STACK_NAME=BetterVibeStack
TABLE_PREFIX=BetterVibe
FRONTEND_BUCKET_PREFIX=bettervibe-frontend
